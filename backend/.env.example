# ============================================================
#  Variables de entorno de PlaneAI UdeA (Backend)
#
#  1. Copia este archivo como ".env"  ->  copy .env.example .env
#     (¡COPIAR, no renombrar! Así conservas esta plantilla.)
#  2. Completa los valores reales.
#  3. El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ============================================================

# --- Google Gemini ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Plan gratuito: Flash-Lite permite 15 solicitudes/min y 500/día (3.8 Flash solo 20/día)
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo alterno si el principal está saturado o sin cuota (tiene su propia cuota)
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
# Preguntas de seguimiento por IA (una llamada extra por mensaje)
SUGERENCIAS_IA=false

# --- Configuracion de la aplicacion ---
APP_NAME=PlaneAI UdeA
APP_ENV=development

# Origenes permitidos para CORS (frontend), separados por coma
CORS_ORIGINS=http://localhost:5173
